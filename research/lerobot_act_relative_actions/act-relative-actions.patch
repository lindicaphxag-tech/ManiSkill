+            steps.add_batch_dim,
+            steps.to_device,
+            relative_step,
+            steps.normalize,
+        ],
+        output_steps=[
+            steps.unnormalize,
+            AbsoluteActionsProcessorStep(enabled=True, relative_step=relative_step),
+            steps.to_cpu,
+        ],
+    )
